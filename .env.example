# ── Сервер BodyTrain (server/) ──────────────────────────────────────
# PostgreSQL. Локально: createdb bodytrain
DATABASE_URL=postgres://localhost:5432/bodytrain
# Секрет подписи сессий: openssl rand -hex 32  (обязателен в production)
JWT_SECRET=
PORT=8787

# ── Telegram Mini App ───────────────────────────────────────────────
# Токен бота от @BotFather. Без него вход из Telegram выключен.
TELEGRAM_BOT_TOKEN=
# Публичный HTTPS-адрес, где сервер раздаёт приложение (он же URL Mini App)
PUBLIC_URL=https://bodytrain.example.com
# Любая случайная строка: Telegram присылает её в заголовке webhook
TELEGRAM_WEBHOOK_SECRET=
# Сколько секунд действительна подпись initData (по умолчанию сутки)
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# ── Рейтинг ─────────────────────────────────────────────────────────
# По какому часовому поясу считаются «сегодня» и «неделя»
LEADERBOARD_TZ=Europe/Moscow

# За nginx / Railway / Render — брать IP из X-Forwarded-For
TRUST_PROXY=0
# Каталог веб-сборки, которую раздаёт сервер (в production по умолчанию dist)
# STATIC_DIR=dist

# ── Сборка iOS ──────────────────────────────────────────────────────
# Адрес сервера для iOS-приложения (подставляется при npm run build)
# VITE_API_URL=https://bodytrain.example.com
