{
  "name": "bodytrain",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/test.mjs",
    "cap:sync": "npm run build && npx cap sync ios",
    "cap:open": "npx cap open ios",
    "ios:sim": "bash scripts/run-sim.sh",
    "ios:ipa": "bash scripts/build-ipa.sh",
    "server:dev": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "server:build": "esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=server/dist/index.mjs",
    "server:start": "node --env-file-if-exists=.env server/dist/index.mjs",
    "test:server": "node --import tsx --test server/test/*.test.ts",
    "tg:link": "tsx --env-file-if-exists=.env scripts/tg-dev-link.ts",
    "tg:setup": "node --env-file-if-exists=.env scripts/tg-setup.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.13",
    "jose": "^5.10.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.24.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  }
}
